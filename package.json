{
  "name": "foottfall-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --force",
    "build": "npm run prepare-all && vite build",
    "test": "vitest run",
    "preview": "vite preview",
    "clean": "rimraf node_modules/.vite dist",
    "prepare-cities": "node scripts/prepare_data.cjs",
