    "prepare-all": "npm run prepare-cities && npm run generate-data && npm run import-properties"
  },
  "dependencies": {
    "chart.js": "^4.4.7",
    "maplibre-gl": "^4.7.1",
    "papaparse": "^5.4.1"
  },
  "devDependencies": {
    "axios": "^1.16.1",
    "googlethis": "^1.8.0",
    "replace-in-file": "^8.4.0",
    "rimraf": "^6.1.3",
    "vite": "^6.0.0",
    "vitest": "^2.1.8",
    "xlsx": "^0.18.5"
  }
}
